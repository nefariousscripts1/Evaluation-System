DATABASE_URL="mysql://root:[PASSWORD]@[HOST]:[PORT]/railway"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
AUTH_SECRET="${NEXTAUTH_SECRET}"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="${NEXTAUTH_URL}"
RESEND_API_KEY=""
EMAIL_FROM="Digital Evaluation System <noreply@example.com>"
GMAIL_USER="your-email@example.com"
GMAIL_APP_PASSWORD="your-app-password"

# Railway notes:
# - In Railway, set DATABASE_URL to your MySQL service reference or full connection string.
# - Set NEXTAUTH_SECRET to a long random value.
# - You can omit NEXTAUTH_URL/AUTH_URL on Railway because the app will derive them
#   from RAILWAY_PUBLIC_DOMAIN automatically.
#
# Vercel notes:
# - In Vercel, set DATABASE_URL and NEXTAUTH_SECRET in Project Settings -> Environment Variables.
# - You can usually omit NEXTAUTH_URL/AUTH_URL on Vercel because the app can derive them
#   from VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL.
# - Optional: set AUTH_DEBUG=true temporarily if you want more auth logs in Vercel during troubleshooting.
